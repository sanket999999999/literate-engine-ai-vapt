# ---------------------------------------------------------------- AI triage
# Set a key for any provider you want to use. Providers without a key show as
# unavailable in the dashboard; the scanners still run without any of them.

# Anthropic Claude - best triage quality, and the default when configured.
ANTHROPIC_API_KEY=

# OpenAI GPT.
OPENAI_API_KEY=

# Google Gemini (GOOGLE_API_KEY is also accepted).
GEMINI_API_KEY=

# Ollama runs locally and needs no key - only a running server.
OLLAMA_HOST=http://127.0.0.1:11434
VAPT_OLLAMA_NUM_CTX=8192
VAPT_OLLAMA_TIMEOUT=900

# Which backend new scans default to.
#   auto  - first configured provider, Claude first (default)
#   none  - scanners only, no AI
#   anthropic | openai | gemini | ollama
VAPT_PROVIDER=auto

# Model override. Empty uses the chosen provider's default.
VAPT_MODEL=

# ------------------------------------------------------------ repositories
# Optional tokens for cloning private repositories.
GITHUB_TOKEN=
GITLAB_TOKEN=

# ----------------------------------------------------------------- runtime
VAPT_DATA_DIR=./data
VAPT_SCANNER_TIMEOUT=900
VAPT_MAX_CONCURRENT_SCANS=2

# Triage batching and budget cap.
VAPT_TRIAGE_BATCH_SIZE=12
VAPT_TRIAGE_MAX_FINDINGS=400

# Semgrep rulesets (comma separated).
VAPT_SEMGREP_CONFIG=p/security-audit,p/owasp-top-ten,p/secrets
